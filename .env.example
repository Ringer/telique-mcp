# Required: Telique API key (tlq_…). The API refuses requests without one
# unless they come from an allowlisted IP. Get one at https://app.telique.ringer.tel
TELIQUE_API_TOKEN=your-token-here

# Optional: Base URL (default: https://api.telique.ringer.tel). A path prefix
# here is kept, e.g. https://gateway.example/telique
# TELIQUE_API_BASE_URL=https://api.telique.ringer.tel

# Optional: HTTP request timeout in milliseconds (default: 10000)
# TELIQUE_REQUEST_TIMEOUT_MS=10000
